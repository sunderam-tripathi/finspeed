{
  "$id": "https://finspeed.online/data/faq-entry.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FAQ-001 support FAQ content",
  "type": "object",
  "required": ["locale", "topics"],
  "additionalProperties": false,
  "properties": {
    "locale": {
      "type": "string",
      "enum": ["en", "hi"]
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "faqs"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "faqs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["question", "answer"],
              "additionalProperties": false,
              "properties": {
                "question": { "type": "string", "minLength": 10 },
                "answer": { "type": "string", "minLength": 20, "maxLength": 1000 },
                "related_links": {
                  "type": ["array", "null"],
                  "items": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        }
      }
    },
    "last_updated": { "type": "string", "format": "date" }
  }
}
