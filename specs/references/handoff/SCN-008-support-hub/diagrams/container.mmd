flowchart TD
  browser[Visitor browser] --> supportRoute[`/support` route]
  supportRoute --> supportHub[SupportHub component (`IC-16`)]
  supportHub --> channelTiles[ChannelTiles]
  supportHub --> incidentBanner[IncidentBanner]
  supportHub --> faqSearch[FaqSearch]
  supportHub --> contactForm[SupportForm (`IC-7` reuse)]
  supportHub --> analyticsHook[AnalyticsEmitter]
  supportHub --> consentManager[Consent manager]
  supportHub --> supportData[Support channels JSON]
  supportHub --> faqData[FAQ JSON]
  supportHub --> statusFeed[Status JSON]
  analyticsHook --> ga4[GA4 Measurement API]
  contactForm --> formspree[Formspree endpoint]
  supportData <-. build pipeline .-> contactYAML[`contact-points.yaml`]
  faqData <-. build pipeline .-> faqMDX[`content/support/faq/{locale}.mdx`]
  statusFeed <-- ops updates --> ops[Support ops]
