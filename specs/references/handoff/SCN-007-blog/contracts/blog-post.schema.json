{
  "$id": "https://finspeed.online/data/blog-post.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BLOG-001 blog post front-matter",
  "type": "object",
  "required": ["slug", "locale", "title", "excerpt", "tags", "publishDate", "readingMinutes"],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "locale": {
      "type": "string",
      "enum": ["en", "hi"]
    },
    "title": {
      "type": "string",
      "minLength": 10
    },
    "excerpt": {
      "type": "string",
      "minLength": 30,
      "maxLength": 220
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "hero": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "src": { "type": "string" },
        "alt": { "type": "string" }
      }
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "role": { "type": ["string", "null"] },
        "avatar": { "type": ["string", "null"] }
      }
    },
    "publishDate": {
      "type": "string",
      "format": "date"
    },
    "readingMinutes": {
      "type": "integer",
      "minimum": 2,
      "maximum": 20
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"]
    },
    "related": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    }
  }
}
