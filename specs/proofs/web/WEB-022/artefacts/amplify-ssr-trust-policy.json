{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "amplify.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "ArnLike": {
          "aws:SourceArn": "arn:aws:amplify:ap-south-1:660883642048:apps/*"
        },
        "StringEquals": {
          "aws:SourceAccount": "660883642048"
        }
      }
    }
  ]
}
